# Large subsystems not used by the current board bring-up.
CONFIG_ACPI=n
CONFIG_ATA=n
CONFIG_BPF_SYSCALL=n
CONFIG_CGROUPS=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_SUN4I=n
CONFIG_FTRACE=n
CONFIG_HUGETLBFS=n
CONFIG_MD=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_MTD=n
CONFIG_NET=n
CONFIG_PCI=n
CONFIG_PERF_EVENTS=n
CONFIG_SCSI=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_VIRTUALIZATION=n

# Board drivers not enabled by RISC-V defconfig.
CONFIG_RUST=y
CONFIG_SERIAL_BFLB_RUST=y
CONFIG_PINCTRL_BL808=y
CONFIG_COMMON_CLK_BL808_MM_SPI=y
CONFIG_MFD_SYSCON=y
CONFIG_SPI_BFLB_RUST=y
CONFIG_PWM_BFLB=y
CONFIG_DRM=y
CONFIG_DRM_PANEL_MIPI_DBI=y
CONFIG_BACKLIGHT_GPIO=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Only the Rust validation suites for these drivers and their core APIs.
CONFIG_KUNIT=y
CONFIG_KUNIT_ALL_TESTS=n
CONFIG_RUST_SERIAL_KUNIT_TEST=y
CONFIG_RUST_SPI_KUNIT_TEST=y
CONFIG_SPI_BFLB_RUST_KUNIT_TEST=y
CONFIG_PWM_BFLB_KUNIT_TEST=y
